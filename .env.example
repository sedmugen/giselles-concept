# Giselle's Concept - Environment Configuration Template
# Duplicate this file as .env when integrating with backend services

# Application Environment
NODE_ENV=development
PORT=3000

# Base URL & Domain
PUBLIC_URL=http://localhost:3000

# Client-Side Feature Flags
ENABLE_ANALYTICS=false
ENABLE_SUBSCRIPTIONS=true
DEFAULT_CURRENCY=USD

# Optional Third-Party Services (Future Roadmap)
# STRIPE_PUBLIC_KEY=pk_test_...
# NEWSLETTER_API_ENDPOINT=https://api.example.com/newsletter
